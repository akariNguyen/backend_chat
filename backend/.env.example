# Copy to backend\.env (not committed) and adjust.
# 0.0.0.0 = accept other machines (open the port in the firewall); 127.0.0.1 = this machine only.
BRAND_API_HOST=0.0.0.0
BRAND_API_PORT=8765
# Optional. Empty = no key needed. To require one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
BRAND_API_KEY=
